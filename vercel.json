{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run typecheck",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "devCommand": "",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 5 * * *"
    }
  ]
}
