# Токен Telegram-бота
TELEGRAM_BOT=123456:ABC...

# Публичный URL после деплоя на Vercel (для локальной настройки webhook)
PUBLIC_URL=https://your-app.vercel.app

# Секрет для проверки webhook-запросов от Telegram (рекомендуется)
WEBHOOK_SECRET=random-long-secret

# Секрет для /api/setup и cron-задач (рекомендуется)
SETUP_SECRET=another-random-secret
CRON_SECRET=another-random-secret

# Upstash Redis (добавляется при подключении Storage -> Upstash Redis в Vercel)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
